/*
 * client_send.bt — app→server draw-call 송신(IPC) 비용 측정  [tracepoint, 심볼 불필요]
 *
 * 사용:  sudo bpftrace client_send.bt <app_comm>
 *        예) sudo bpftrace client_send.bt stress
 *
 * 주의: comm 은 최대 15자까지만 비교됨(task comm 한계). 앱 바이너리 이름이 길면 앞 15자.
 *
 * 출력 해석:
 *   @count        : sendto() 총 횟수  ==  draw call 수 (1 draw = 1 syscall 확인)
 *   @bytes        : draw 1건당 전송 페이로드 크기 분포 (대부분 수십 byte → 배치 여유 큼)
 *   @send_lat_us  : sendto() 1건 지연 분포(μs). 소켓 송신버퍼가 차면 꼬리가 길어짐=backpressure
 *   @lat_total_us : 누적 sendto syscall 시간(μs). "draw마다 보내는" 총 커널 오버헤드.
 */

BEGIN { printf("client send 측정: comm=%s  (Ctrl-C 종료)\n", str($1)); }

tracepoint:syscalls:sys_enter_sendto /comm == str($1)/
{
    @ts[tid] = nsecs;
    @count   = count();
    @bytes   = hist(args->len);
}

tracepoint:syscalls:sys_exit_sendto /@ts[tid]/
{
    $d = nsecs - @ts[tid];
    @send_lat_us  = hist($d / 1000);
    @lat_total_us = sum($d / 1000);
    delete(@ts[tid]);
}

END { clear(@ts); }
