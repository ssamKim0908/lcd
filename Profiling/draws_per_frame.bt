/*
 * draws_per_frame.bt — 프레임당 draw call 분포 & draw 1건 체감비용  [uprobe, 심볼 필요]
 *
 * uprobe attach point 의 바이너리 경로는 "리터럴"이어야 한다(positional param 불가).
 * 아래 4곳의 경로 /PATH/TO/app 를 본인 환경의 앱 절대경로로 바꾼 뒤 실행:
 *   sudo bpftrace draws_per_frame.bt
 *
 * 심볼 확인(정적 링크된 libsdk.a 심볼이 앱 ELF 안에 있어야 함, strip 금지):
 *   nm -C <app_bin> | grep -E 'UdsChannel::send|IpcCToS::render|IpcCToS::fill_rect'
 * 매칭되는 mangled 심볼 목록 확인:
 *   sudo bpftrace -l 'uprobe:<app_bin>:*IpcCToS*'
 *
 * 출력 해석:
 *   @per_frame    : render() 사이의 draw call 수 분포 → 정상앱 p99 = "큐 용량 하한"
 *   @draw_cost_us : fill_rect 진입~반환 시간 = 직렬화 + sendto 합 (앱이 체감하는 draw 비용)
 *
 * 주의: render() 자신도 send() 1회를 호출하므로 @cur 를 -1 로 되돌려 보정한다(아래 설명).
 */

/* 프레임 경계: render() 진입 시점 = 직전까지 쌓인 draw send 수가 곧 그 프레임의 draw 수 */
uprobe:/PATH/TO/app:"*IpcCToS*render*"
{
    @per_frame = hist(@cur);
    @cur = -1;            /* 직후 render 자신의 send 가 @cur 를 0 으로 되돌림 → 다음 프레임은 0부터 */
}

/* 모든 draw flush 가 거치는 단일 choke point */
uprobe:/PATH/TO/app:"*UdsChannel*send*"  { @cur++; }

/* draw 1건의 유저공간+syscall 총비용 (stress 앱은 fill_rect 만 사용) */
uprobe:/PATH/TO/app:"*IpcCToS*fill_rect*"     { @c[tid] = nsecs; }
uretprobe:/PATH/TO/app:"*IpcCToS*fill_rect*" /@c[tid]/
{
    @draw_cost_us = hist((nsecs - @c[tid]) / 1000);
    delete(@c[tid]);
}

END { clear(@c); clear(@cur); }
